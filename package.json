{
  "name": "path-profile",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "bun run build:renderer",
    "build:desktop": "bun run build:renderer && bun run build:electron && bun run prepare:release-assets",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --external:gdal-async --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --outfile=dist-electron/preload.cjs && esbuild electron/raster-worker.ts --bundle --platform=node --target=node20 --format=cjs --external:gdal-async --outfile=dist-electron/raster-worker.cjs",
    "build:renderer": "next build",
    "check": "bun run typecheck && bun run format:check",
    "dev": "bun run dev:web",
    "dev:desktop": "concurrently -k -n next,electron -c cyan,magenta \"bun run dev:web\" \"wait-on http://localhost:3010 && bun run dev:electron\"",
    "dev:electron": "bun run build:electron && node scripts/launch-electron.cjs .",
    "dev:web": "bun run build:electron && next dev -p 3010",
    "dist:win": "bun run dist:win:installer",
    "dist:win:dir": "bun run build:desktop && electron-builder --win dir --x64",
    "dist:win:installer": "bun run build:desktop && electron-builder --win nsis --x64",
    "dist:win:zip": "bun run build:desktop && electron-builder --win zip --x64",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "prepare:release-assets": "node scripts/prepare-release-assets.cjs",
    "rebuild:native": "bun pm trust gdal-async",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@mapbox/node-pre-gyp": "^2.0.0",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^20.14.10",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "chart.js": "^4.5.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "gdal-async": "^3.12.3",
    "lucide-react": "^1.14.0",
    "next": "^15.2.3",
    "ol": "^10.9.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.5"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "build": {
    "appId": "com.pathprofile.desktop",
    "productName": "Path Profile",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".release-assets/node",
        "to": "node",
        "filter": [
          "node.exe"
        ]
      },
      {
        "from": ".release-assets/node_modules",
        "to": "node_modules"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "dist-electron/raster-worker.cjs"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Path-Profile-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Path-Profile-Setup-${version}-win-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Path Profile"
    }
  },
  "trustedDependencies": [
    "electron-winstaller",
    "esbuild",
    "gdal-async",
    "sharp"
  ]
}
